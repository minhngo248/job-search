# API Configuration
VITE_API_GATEWAY_URL=https://your-api-gateway-url.amazonaws.com/prod

# Development Configuration
VITE_APP_NAME=Regulatory Jobs App
VITE_APP_VERSION=1.0.0

# Cognito / OIDC Configuration
VITE_COGNITO_AUTHORITY=https://cognito-idp.<REGION>.amazonaws.com/<USER_POOL_ID>
VITE_COGNITO_CLIENT_ID=<COGNITO_CLIENT_ID>
VITE_COGNITO_DOMAIN=https://<YOUR_COGNITO_DOMAIN>.auth.<REGION>.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=<YOUR_REDIRECT_URI>
VITE_COGNITO_LOGOUT_URI=<YOUR_LOGOUT_URI>
VITE_COGNITO_SCOPE=<YOUR_OIDC_SCOPES>